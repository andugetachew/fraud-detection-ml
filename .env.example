# Same URL format as your other Neon-backed projects.
# Leave unset for local dev — falls back to a local SQLite registry.
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/fraud_ml?sslmode=require

# Same isolated-db-number pattern as your other projects sharing one Upstash
# instance in prod. Locally, docker-compose points this at its own redis service.
REDIS_URL=redis://localhost:6379/4

DEBUG=true

# Required for /predict, /model/reload, /model/drift. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme